# Configuração do Banco de Dados
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME"

# Chave secreta para assinatura dos tokens JWT
JWT_SECRET="SUA_CHAVE_SECRETA_AQUI"

# Chave secreta para criptografia de assinatura
SIGNATURE_ENCRYPTION_KEY='SUA CRYPTKEY AQUI'

# Chave de API para GOOGLE MAPS API
GOOGLE_MAPS_API_KEY="SUA API AQUI"
VITE_GOOGLE_MAPS_API_KEY="SUA API AQUI"

# Porta em que o servidor backend irá rodar
PORT=3001
